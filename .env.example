GREENVIDEO_API_HOST=127.0.0.1
GREENVIDEO_API_PORT=8000
GREENVIDEO_DATABASE_URL=sqlite:///./storage/greenvideo.db
GREENVIDEO_STORAGE_DIR=./storage
GREENVIDEO_CELERY_BROKER_URL=redis://localhost:6379/0
GREENVIDEO_CELERY_RESULT_BACKEND=redis://localhost:6379/1
TARO_APP_API_BASE_URL=http://127.0.0.1:8000

# AI 去水印配置（可选）
# 是否启用 AI 修复功能（需要部署 IOPaint 服务）
GREENVIDEO_IOPAINT_ENABLED=true
# IOPaint 服务地址
GREENVIDEO_IOPAINT_BASE_URL=http://127.0.0.1:8080
# 使用的模型：lama / mat / migan / zits
GREENVIDEO_IOPAINT_MODEL=lama
